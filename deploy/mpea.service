[Unit]
Description=MPEA alloy stability predictor
After=network.target

[Service]
DynamicUser=yes
WorkingDirectory=/srv/mpea
CacheDirectory=mpea
Environment=XDG_CACHE_HOME=/var/cache/mpea
Environment=MPLCONFIGDIR=/var/cache/mpea/matplotlib
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/srv/mpea/.venv/bin/gunicorn --workers 1 --timeout 120 --bind 127.0.0.1:8173 --access-logfile - flask_app:app
Restart=on-failure
RestartSec=3
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
